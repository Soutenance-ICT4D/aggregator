# Application
SPRING_ENV=dev
SPRING_SERVER_PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sharepay_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT
# Générer avec : openssl rand -hex 64
JWT_SECRET=your-super-long-and-secure-secret-key-min-256-bits-for-hs256
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# Email — SMTP
MAIL_HOST=smtp.ionos.fr
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=your_sender@example.com

# URLs applicatives
CHECKOUT_BASE_URL=http://localhost:3001/checkout/
COLLECT_BASE_URL=http://localhost:3001/collect/
SHAREPAY_URL=http://localhost:3000

# Payment Providers
PAYMENT_BASE_URL=https://api.nokash.app
PAYMENT_I_SPACE_KEY=your_i_space_key
PAYMENT_APP_SPACE_KEY=your_app_space_key
PAYMENT_PAYIN_PATH=/lapas-on-trans/trans/api-payin-request/407
PAYMENT_STATUS_PATH=/lapas-on-trans/trans/310/status-request
MTN_CALLBACK_URL=http://localhost:3001/api/v1/provider-webhook/MTN_MOMO_CM
ORANGE_NOTIF_URL=http://localhost:3001/api/v1/provider-webhook/ORANGE_MONEY_CM

# Admin par défaut
# Générer le hash avec : python3 -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt(12)).decode())"
ADMIN_EMAIL=admin@sharepay.com
ADMIN_PASSWORD_HASH='your_bcrypt_hash'
